# ==============================================================================
# FINROUTE COLLECT - CLIENT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Only VITE_* variables are bundled, and everything here is PUBLIC in the
# browser. Never put service-role keys, secret keys or passwords in this file.

# Master Supabase project (URL + publishable key)
VITE_MASTER_SUPABASE_URL=https://YOUR_MASTER_PROJECT.supabase.co
VITE_MASTER_SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY
